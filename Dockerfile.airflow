# Imagem do Airflow com as bibliotecas do projeto (pandas, pyarrow, psycopg
# etc.) instaladas -- necessário porque a imagem oficial do Airflow não vem
# com essas dependências, e as tasks da DAG chamam nossos scripts Python
# diretamente.
FROM apache/airflow:2.10.4-python3.12

COPY requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt